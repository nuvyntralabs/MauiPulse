<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Pulse.Sample.MainPage"
             Title="Pulse Sample">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="UseMauiPulse()"
                   FontSize="26"
                   FontAttributes="Bold" />
            <Label x:Name="PackageLabel" FontAttributes="Bold" />
            <Label Text="This host only calls UseMauiPulse(). Taps raise demo plugin events. Pulse forwards them. There is no HttpClient POST in the page."
                   LineBreakMode="WordWrap" />

            <Label x:Name="EndpointLabel" FontSize="12" />

            <Label Text="Raise plugin events" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                <Button Text="Network" Clicked="OnNetworkClicked" />
                <Button Grid.Column="1" Text="API" Clicked="OnApiClicked" />
                <Button Grid.Row="1" Text="Queue" Clicked="OnQueueClicked" />
                <Button Grid.Row="1" Grid.Column="1" Text="Sync" Clicked="OnSyncClicked" />
                <Button Grid.Row="2" Text="Perms" Clicked="OnPermsClicked" />
                <Button Grid.Row="2" Grid.Column="1" Text="Health" Clicked="OnHealthClicked" />
                <Button Grid.Row="3" Text="Leak" Clicked="OnLeakClicked" />
                <Button Grid.Row="3" Grid.Column="1" Text="Crash" Clicked="OnCrashClicked" />
                <Button Grid.Row="4" Text="Session" Clicked="OnSessionClicked" />
                <Button Grid.Row="4" Grid.Column="1" Text="All lanes" Clicked="OnAllLanesClicked" />
            </Grid>

            <Label Text="pull / queues / sync / incident" FontAttributes="Bold" />
            <Button Text="Seed plugin files" Clicked="OnSeedClicked" />
            <Label x:Name="FilesLabel" LineBreakMode="WordWrap" FontSize="12" />

            <Label Text="Log" FontAttributes="Bold" />
            <Border StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 8">
                <Label x:Name="LogLabel"
                       Text="Start maui-pulse attach, then tap a lane. Pulse sends the event."
                       FontSize="12"
                       LineBreakMode="WordWrap" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
